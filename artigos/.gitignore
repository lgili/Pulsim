# LaTeX build artefacts — never commit these
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# Generated paper PDFs (regenerable from LaTeX source via build.sh)
# — but we DO track figure PDFs in _shared/figures/ (publication assets).
*.pdf
!_shared/figures/**/*.pdf

# ngspice regenerated traces (re-run the benchmark to recreate)
**/*_ngspice_out.txt
**/*_ngspice_out.raw

# Force-include benchmark summary CSVs (root .gitignore excludes *.csv,
# but these capture specific reproducible measurements — track them).
!02_tpel_methods/benchmarks/results/*.csv

# Python cache
__pycache__/
*.pyc
