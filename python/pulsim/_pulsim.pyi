class Graph:
    """
    Pulsim topology graph. Build via CircuitBuilder; access via builder.graph.
    """
    @staticmethod
    def ground() -> int:
        ...
    def branch_name(self, branch_id: int) -> str:
        """
        The branch's user-facing name, or '' when it was created without one.
        """
