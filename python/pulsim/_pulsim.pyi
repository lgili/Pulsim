    def add_pulse_voltage_source(self, name: str, n_pos: str, n_neg: str, v_initial: float, v_pulsed: float, t_start: float, pulse_width: float, period: float = 0.0, rise_time: float = 0.0, fall_time: float = 0.0) -> CircuitBuilder:
