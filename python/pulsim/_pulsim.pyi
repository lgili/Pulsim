    def add_saturable_transformer_n(self, name: str, p_from: str, p_to: str, N_p: float, L_leak_p: float, secondaries: collections.abc.Sequence[tuple[str, str, float, float]], Ae: float, le: float, lg: float, mu_r0: float = 2000.0, B_sat: float = 0.35) -> CircuitBuilder:
        """
        Saturable transformer with ANY number of secondaries: secondaries = [(s_from, s_to, N_s, L_leak_s), ...]. One gapped-core magnetising branch (name + '.m') on the primary and one ideal transformer per secondary (name + '.s' + k, n_k = N_k/N_p). No winding ceiling.
