+        c->u_values_ = u_values_;
+        c->Prow_ = Prow_;
+        c->Pinv_row_ = Pinv_row_;
+        c->analyzed_ = analyzed_;
+        c->factorized_ = factorized_;
+        c->numeric_singular_ = numeric_singular_;
+        c->ordering_ = ordering_;
