+    /// Tier 2: factor `J` (a first visit of `mask`) by `partial_refactor`
+    /// on a copy of the nearest resident segment's factor (Hamming
+    /// distance; ties: most recently used). Only the columns whose values
+    /// differ are re-eliminated, with the neighbour's row order. Returns
+    /// nullptr — and the caller factorises on the shared analysis — when
+    /// there is no usable neighbour, the elimination path is longer than
+    /// `MAX_PATH_LENGTH_RATIO · n`, or `partial_refactor` reports a pivot
+    /// or pattern fault.
+    [[nodiscard]] std::unique_ptr<sparse::DirectSolver>
+    try_flip_refactor_(const topology::SwitchStateMask& mask,
+                       const sparse::Matrix& J) {
+        if (!flip_refactor_ || segments_.empty() || !J.isCompressed()) {
+            return nullptr;
+        }
+        const PwlSegment* nb = nullptr;
+        Size best = 0;
+        for (const auto& [m, seg] : segments_) {
+            const Size d = mask.hamming_distance(m);
+            if (nb == nullptr || d < best ||
+                (d == best && seg.tick() > nb->tick())) {
+                nb = &seg;
+                best = d;
+            }
+        }
+        const auto* lu =
+            dynamic_cast<const sparse::PulsimSparseLuSolver*>(nb->solver.get());
+        const sparse::Matrix& A = nb->J;
+        if (lu == nullptr || !lu->is_factorized() || !A.isCompressed() ||
+            A.rows() != J.rows() || A.nonZeros() != J.nonZeros() ||
+            !std::equal(A.outerIndexPtr(), A.outerIndexPtr() + A.outerSize() + 1,
+                        J.outerIndexPtr()) ||
+            !std::equal(A.innerIndexPtr(), A.innerIndexPtr() + A.nonZeros(),
+                        J.innerIndexPtr())) {
+            return nullptr;   // another regime or pattern: not a neighbour
+        }
+        std::vector<Index> cols;
+        for (Index j = 0; j < J.outerSize(); ++j) {
+            for (Index p = J.outerIndexPtr()[j]; p < J.outerIndexPtr()[j + 1]; ++p) {
+                if (A.valuePtr()[p] != J.valuePtr()[p]) {
+                    cols.push_back(j);
+                    break;
+                }
+            }
+        }
+        auto c = lu->clone();
+        if (static_cast<Real>(c->partial_refactor_count_path(cols)) <=
+                sparse::MAX_PATH_LENGTH_RATIO * static_cast<Real>(J.rows()) &&
+            c->partial_refactor(J, cols)) {
+            flip_partial_refactors_.fetch_add(1, std::memory_order_relaxed);
+            return c;
+        }
+        flip_fallbacks_.fetch_add(1, std::memory_order_relaxed);
+        return nullptr;
+    }
 
