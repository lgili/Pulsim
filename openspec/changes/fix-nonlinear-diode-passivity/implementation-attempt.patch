 //
 // `pulsim-v2-device-models-ad-driven` Phase 5.
 //
-// Smooth-blend Norton-shifted ideal diode. The nonlinear "AD killer
-// test" — if AD works here, it works for every device in Pulsim's
-// catalogue.
+// Smooth soft-knee diode. The nonlinear "AD killer test" — if AD
+// works here, it works for every device in Pulsim's catalogue.
 //
-// Model:
+// Model (fix-nonlinear-diode-passivity):
 //
 //   v_diode = v[0] - v[1]                          (anode - cathode)
-//   alpha   = 1 / (1 + exp(-kappa · (v_diode - V_F0)))
-//                                                  (sigmoid on/off)
-//   i_on    = alpha · (v_diode - V_F0) / R_d       (Norton-shifted)
-//   i_off   = (1 - alpha) · v_diode · G_off        (reverse leakage)
-//   current = i_on + i_off
+//   sp(x)   = ln(1 + e^x)                          (numeric/softplus.hpp)
+//   current = [sp(kappa·(v_diode - V_F0)) - sp(-kappa·V_F0)] / (kappa·R_d)
+//             + G_off · v_diode
+//   di/dv   = logistic(kappa·(v_diode - V_F0)) / R_d + G_off  > 0
 //
-// Reverse-biased (v_diode ≪ V_F0): alpha ≈ 0 → current ≈ v_diode·G_off
-//   (small leakage, typically pA range)
-// Forward-biased (v_diode ≫ V_F0): alpha ≈ 1 → current ≈ (v_diode -
-//   V_F0)/R_d (linear past V_F0, with slope 1/R_d)
-// Threshold (v_diode ≈ V_F0): alpha ≈ 0.5, smooth blend
+// Passive and monotone for every finite v: i(0) = 0 exactly and
+// i·v >= 0. The earlier law, logistic·(v - V_F0)/R_d, was negative
+// for every 0 < v < V_F0 (-1.392 A at 0.636 V at the defaults): it
+// sourced power and gave Newton a region of negative conductance.
+//
+// Forward (v_diode ≫ V_F0): current → (v_diode - V_F0)/R_d, the same
+//   asymptote as before; the knee is rounded outward by ≤ ln2/kappa.
+// Reverse (v_diode ≪ 0): current → -sp(-kappa·V_F0)/(kappa·R_d)
+//   + G_off·v_diode. The constant floor is 4.16 µA at the defaults
+//   and grows as kappa·V_F0 shrinks (ln2/(kappa·R_d) at V_F0 = 0).
 //
 // `kappa` controls the sigmoid sharpness. Typical: 20-50/V. Too
 // sharp → Newton struggles at the transition; too soft → off-state
@@ -40,7 +43,7 @@
 
 #include "pulsim/ad/ad_scalar.hpp"
 #include "pulsim/numeric/concepts.hpp"
-#include "pulsim/numeric/logistic.hpp"
+#include "pulsim/numeric/softplus.hpp"
 #include "pulsim/numeric/types.hpp"
 #include "pulsim/topology/graph.hpp"
 
@@ -62,22 +65,17 @@ struct IdealDiode {
     static constexpr bool is_linear = false;
 
     /// Current from terminal 0 (anode) to terminal 1 (cathode).
-    /// Templated on any FloatingPoint type; ADL handles `exp` via
-    /// `using std::exp` so `S = Real` and `S = ADRealN<N>` both
-    /// dispatch correctly.
+    /// Instantiated for `Real` and `ADRealN<N>`; `numeric::softplus`
+    /// has an overload for each.
     template <numeric::FloatingPoint S>
     [[nodiscard]] static S current(const S* v, const Params& p) noexcept {
-        using std::exp;
         const S v_diode = v[0] - v[1];
-        const S delta = v_diode - p.V_F0;
-        // Overflow-free logistic: written as 1/(1+exp(-k*d)) this
-        // produces a NaN Jacobian entry once k*|d| passes 709, which
-        // an ordinary mains rectifier reaches in its first
-        // half-cycle. See numeric/logistic.hpp.
-        const S alpha = numeric::logistic(S{p.kappa * delta});
-        const S i_on  = alpha * delta * (S{1} / p.R_d);
-        const S i_off = (S{1} - alpha) * v_diode * p.G_off;
-        return i_on + i_off;
+        // softplus keeps exp in (0, 1], so neither the value nor the AD
+        // Jacobian overflows at any reverse bias (numeric/softplus.hpp).
+        const S knee = numeric::softplus(S{p.kappa * (v_diode - p.V_F0)});
+        const Real knee_at_zero = numeric::softplus(Real{-p.kappa * p.V_F0});
+        return (knee - S{knee_at_zero}) * (S{1} / (p.kappa * p.R_d))
+             + v_diode * p.G_off;
     }
 };
 
