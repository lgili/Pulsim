diff --git a/core/include/pulsim/numeric/softplus.hpp b/core/include/pulsim/numeric/softplus.hpp
new file mode 100644
index 00000000..cd2a826e
--- /dev/null
+++ b/core/include/pulsim/numeric/softplus.hpp
@@ -0,0 +1,39 @@
+#pragma once
+
+// =============================================================================
+// Pulsim — the softplus ln(1 + e^x), evaluated so it cannot overflow
+// =============================================================================
+//
+// sp(x) = max(x, 0) + log1p(exp(-|x|)), whose derivative is
+// logistic(x). Written the textbook way, ln(1 + exp(x)) overflows to
+// inf once x > 709 and loses every digit of the reverse tail to the
+// `1 +` rounding; this form keeps `exp` in (0, 1].
+//
+// The AD overload sets the derivative directly from `logistic`, so no
+// intermediate `exp` can overflow under forward-mode AD either (see
+// numeric/logistic.hpp for why that matters to Newton).
+
+#include "pulsim/ad/ad_scalar.hpp"
+#include "pulsim/numeric/logistic.hpp"
+#include "pulsim/numeric/types.hpp"
+
+#include <array>
+#include <cmath>
+
+namespace pulsim::numeric {
+
+/// `ln(1 + exp(x))`, finite and accurate for every finite `x`.
+[[nodiscard]] inline Real softplus(Real x) noexcept {
+    return (x > Real{0} ? x : Real{0}) + std::log1p(std::exp(-std::abs(x)));
+}
+
+/// AD overload: value as above, derivative `logistic(x)`.
+template <Size N>
+[[nodiscard]] inline ad::ADRealN<N> softplus(const ad::ADRealN<N>& x) noexcept {
+    const Real s = logistic(x.value());
+    std::array<Real, N> d{};
+    for (Size i = 0; i < N; ++i) d[i] = s * x.deriv(i);
+    return ad::ADRealN<N>{softplus(x.value()), d};
+}
+
+}  // namespace pulsim::numeric
diff --git a/core/tests/layer0/test_softplus.cpp b/core/tests/layer0/test_softplus.cpp
new file mode 100644
index 00000000..777cd6db
--- /dev/null
+++ b/core/tests/layer0/test_softplus.cpp
@@ -0,0 +1,52 @@
+// =============================================================================
+// Layer 0 — the overflow-free softplus
+// =============================================================================
+//
+// sp(x) = ln(1 + e^x), derivative logistic(x). The smooth diode law
+// (models/ideal_diode.hpp) is built on it, so it must stay finite and
+// accurate where the textbook form overflows (x > 709) or rounds the
+// reverse tail away (x < -37).
+
+#include <catch2/catch_test_macros.hpp>
+#include <catch2/catch_approx.hpp>
+
+#include "pulsim/ad/ad_scalar.hpp"
+#include "pulsim/numeric/logistic.hpp"
+#include "pulsim/numeric/softplus.hpp"
+
+#include <cmath>
+
+using namespace pulsim;
+using Catch::Approx;
+
+TEST_CASE("softplus matches ln(1 + e^x) where that is representable",
+          "[v2][layer0][softplus]") {
+    for (const Real x : {-30.0, -5.0, -1.0, 0.0, 1.0, 5.0, 30.0}) {
+        INFO("x = " << x);
+        REQUIRE(numeric::softplus(x) ==
+                Approx(std::log1p(std::exp(x))).epsilon(1e-14));
+    }
+    REQUIRE(numeric::softplus(Real{0}) == Approx(std::log(2.0)).epsilon(1e-15));
+}
+
+TEST_CASE("softplus is finite and asymptotically exact at the extremes",
+          "[v2][layer0][softplus]") {
+    REQUIRE(numeric::softplus(Real{1e3}) == Real{1e3});
+    REQUIRE(numeric::softplus(Real{1e300}) == Real{1e300});
+    // Reverse tail: e^x, not 0 (the `1 +` form rounds it away past -37).
+    REQUIRE(numeric::softplus(Real{-50}) == Approx(std::exp(-50.0)).epsilon(1e-12));
+    REQUIRE(numeric::softplus(Real{-1e3}) == Real{0});
+}
+
+TEST_CASE("softplus AD derivative is logistic(x) and never NaN",
+          "[v2][layer0][softplus][ad]") {
+    using AD = ad::ADRealN<1>;
+    for (const Real x : {-1e3, -40.0, -1.0, 0.0, 1.0, 40.0, 1e3}) {
+        const AD s = numeric::softplus(AD{x, {Real{1}}});
+        INFO("x = " << x);
+        REQUIRE(std::isfinite(s.value()));
+        REQUIRE(std::isfinite(s.deriv(0)));
+        REQUIRE(s.value() == numeric::softplus(x));
+        REQUIRE(s.deriv(0) == numeric::logistic(x));
+    }
+}
diff --git a/core/tests/support/smooth_diode_reference.hpp b/core/tests/support/smooth_diode_reference.hpp
new file mode 100644
index 00000000..f094f686
--- /dev/null
+++ b/core/tests/support/smooth_diode_reference.hpp
@@ -0,0 +1,44 @@
+#pragma once
+
+// =============================================================================
+// Test support — closed-form reference for the smooth diode
+// =============================================================================
+//
+// fix-nonlinear-diode-passivity: the smooth diode (models::IdealDiode)
+// conducts
+//
+//   i(v) = [sp(k(v - V_F0)) - sp(-k V_F0)] / (k R_d) + G_off v,
+//   sp(x) = ln(1 + e^x).
+//
+// Written out here independently of the model header, so a test that
+// compares a solver against it checks the model too. `load_line_vd`
+// solves V = v_d + R·i(v_d) (source, diode, resistor in series) by
+// bisection; the residual is strictly increasing in v_d.
+
+#include <algorithm>
+#include <cmath>
+
+namespace pulsim::test_support {
+
+struct SmoothDiode {
+    double V_F0 = 0.7, R_d = 0.01, G_off = 1e-9, kappa = 20.0;
+
+    static double sp(double x) {
+        return std::max(x, 0.0) + std::log1p(std::exp(-std::abs(x)));
+    }
+    double current(double v) const {
+        return (sp(kappa * (v - V_F0)) - sp(-kappa * V_F0)) / (kappa * R_d)
+             + G_off * v;
+    }
+    /// Diode voltage of V -- D -- R -- gnd, V > 0.
+    double load_line_vd(double V, double R) const {
+        double lo = 0.0, hi = V;
+        for (int k = 0; k < 200; ++k) {
+            const double mid = 0.5 * (lo + hi);
+            if (mid + R * current(mid) > V) hi = mid; else lo = mid;
+        }
+        return 0.5 * (lo + hi);
+    }
+};
+
+}  // namespace pulsim::test_support
diff --git a/python/tests/test_nonlinear_diode_passivity.py b/python/tests/test_nonlinear_diode_passivity.py
new file mode 100644
index 00000000..d3c86d5f
--- /dev/null
+++ b/python/tests/test_nonlinear_diode_passivity.py
@@ -0,0 +1,118 @@
+"""The smooth diode (``add_nonlinear_diode``) is passive and monotone.
+
+Its old law, ``logistic(k(v - V_F0))·(v - V_F0)/R_d``, was negative for
+every ``0 < v < V_F0``: at the defaults it pushed -1.392 A out of a
+forward-biased anode at 0.636 V. A 20 V / 1 kHz half-wave clamp then
+aborted on ``engine='pwl'`` at dt = 1 µs and gave RMS 9.634 V on
+``trbdf2`` (the PWL and Shockley diodes give 10.01 V).
+
+The law is now ``[sp(k(v - V_F0)) - sp(-k V_F0)]/(k R_d) + G_off v``
+(softplus): ``i(0) = 0``, ``di/dv > 0``, same forward asymptote.
+
+The SPICE importer no longer produces this device for LTspice's
+``Ron/Roff/Vfwd`` diode: that model is an ideal switch with a series
+drop, i.e. ``add_diode(g_on, g_off, V_th=0, V_f=Vfwd)``.
+"""
+
+from __future__ import annotations
+
+import warnings
+
+import numpy as np
+import pytest
+
+import pulsim as p
+
+
+def _sim(b, **kw):
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        return p.simulate(b, **kw)
+
+
+# ---------------------------------------------------------------------
+# 1.4 forced voltage below the knee
+# ---------------------------------------------------------------------
+
+def _forced(v):
+    b = p.CircuitBuilder()
+    b.add_voltage_source("V", "a", "gnd", v)
+    b.add_nonlinear_diode("D", "a", "gnd", p.IdealDiodeParams())
+    return b
+
+
+def test_forced_voltage_below_the_knee_absorbs_power_on_pwl():
+    r = _sim(_forced(0.636), t_end=1e-5, dt=1e-6, engine="pwl")
+    # res.i of a voltage source is its MNA branch current, which flows
+    # into its + terminal: minus the diode current here.
+    i_diode = -float(np.asarray(r.i("V"))[-1])
+    assert i_diode == pytest.approx(1.22662, abs=1e-3)   # was -1.3923 A
+
+
+def test_forced_voltage_below_the_knee_through_the_dc_operating_point():
+    x = np.asarray(p.compute_dc_op(_forced(0.636)))
+    assert x[0] == pytest.approx(0.636, abs=1e-12)
+    # x = [v(a), i_V]: the source's branch current, minus the diode
+    # current (+1.3923 A before the fix).
+    assert x[-1] == pytest.approx(-1.22662, abs=1e-3)
+
+
+# ---------------------------------------------------------------------
+# 1.5 sine clamp on the fixed and the adaptive engine
+# ---------------------------------------------------------------------
+
+def _clamp():
+    b = p.CircuitBuilder()
+    b.add_sine_voltage_source("V", "in", "gnd", 0.0, 20.0, 1e3)
+    b.add_resistor("Rs", "in", "a", 10.0)
+    b.add_nonlinear_diode("D", "a", "gnd", p.IdealDiodeParams())
+    return b
+
+
+@pytest.mark.parametrize("engine,kw", [("pwl", {"dt": 1e-6}), ("trbdf2", {})])
+def test_sine_clamp_completes_with_the_static_law_rms(engine, kw):
+    r = _sim(_clamp(), t_end=2e-3, engine=engine, **kw)
+    t = np.asarray(r.times)
+    v = np.asarray(r.v("a"))
+    rms = np.sqrt(np.trapezoid(v ** 2, t) / (t[-1] - t[0]))   # adaptive grid: time-weighted
+    assert rms == pytest.approx(10.010, abs=0.02)   # trbdf2 was 9.634 V, pwl aborted
+    assert v.max() == pytest.approx(0.662, abs=0.01)
+
+
+# ---------------------------------------------------------------------
+# 1.6 importer: LTspice Ron/Roff/Vfwd -> PWL diode with V_f
+# ---------------------------------------------------------------------
+
+_NET = """D1 a 0 DX{area}
+.MODEL DX D(Ron=0.05 Roff=1Meg Vfwd=0.7)
+.END
+"""
+
+
+def _component(b, name):
+    return next(c for c in b.components() if c["name"] == name)
+
+
+def test_imported_pwl_diode_is_a_switched_diode_with_a_forward_drop():
+    b = p.spice_to_builder(_NET.format(area=""))
+    c = _component(b, "D1")
+    assert c["kind"] == "diode"
+    prm = c["params"]
+    assert prm["g_on"] == pytest.approx(20.0, rel=1e-12)
+    assert prm["g_off"] == pytest.approx(1e-6, rel=1e-12)
+    assert prm["V_f"] == 0.7
+    assert prm["V_th"] == 0.0
+    # 10 A forward through the diode (builder convention: from = a).
+    b.add_current_source("I1", "a", "gnd", 10.0)
+    r = _sim(b, t_end=2e-3, dt=1e-6, engine="pwl")
+    assert float(np.asarray(r.v("a"))[-1]) == pytest.approx(1.2, rel=1e-9)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        e = next(e for e in p.device_loss_summary(b, r, t_from=1e-3) if e["name"] == "D1")
+    assert e["P_avg"] == pytest.approx(12.0, rel=1e-9)
+
